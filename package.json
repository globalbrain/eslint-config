{
  "name": "@globalbrain/eslint-config",
  "version": "3.1.0",
  "description": "Global Brain's ESLint config",
  "keywords": [
    "eslint",
    "eslint config"
  ],
  "license": "MIT",
  "author": "Kia Ishii <ka.ishii@globalbrains.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalbrain/eslint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "eslint --fix .",
    "build": "tsdown",
    "release": "release-it"
  },
  "dependencies": {
    "@antfu/eslint-config": "8.2.0",
    "@typescript-eslint/rule-tester": "^8.58.1",
    "@vue/compiler-sfc": "^3.5.32",
    "eslint-flat-config-utils": "^3.1.0",
    "eslint-plugin-perfectionist": "^5.8.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.9.2",
    "@emnapi/runtime": "^1.9.2",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/estree": "^1.0.8",
    "eslint": "^9.39.4",
    "release-it": "^19.2.4",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.39.4"
  },
  "packageManager": "pnpm@10.33.0"
}
