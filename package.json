{
  "name": "@globalbrain/eslint-config",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@10.28.1",
  "description": "Global Brain's ESLint config",
  "author": "Kia Ishii <ka.ishii@globalbrains.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalbrain/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint config"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint --fix .",
    "build": "tsdown",
    "release": "release-it"
  },
  "peerDependencies": {
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "@antfu/eslint-config": "7.2.0",
    "eslint-flat-config-utils": "^3.0.0",
    "eslint-plugin-perfectionist": "^5.3.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/estree": "^1.0.8",
    "eslint": "^9.39.2",
    "release-it": "^19.2.4",
    "tsdown": "^0.20.0-beta.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
